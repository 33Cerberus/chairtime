# Copy to .env.production and fill in. Never commit the filled-in file.

# The public host name, without https://. Its DNS record must point at this server.
DOMAIN=book.example.com

# Generate each with:  openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

SHOP_TIMEZONE=Europe/Warsaw

# ---- Online payments (optional) -------------------------------------------------------------
# All three, or none. Without them online payment is switched off and clients pay at the shop.
# Webhook endpoint to register in Stripe:  https://<DOMAIN>/api/v1/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled,
#         charge.refunded, refund.failed
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Text messages (optional) ---------------------------------------------------------------
# All three, or none. Without them reminders are not sent, and password reset by code and
# linking an account to a phone record are unavailable.
# TWILIO_FROM is a sender number, or a Messaging Service SID (MG…).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Photo storage (optional) ---------------------------------------------------------------
# Without S3, photos are kept in the `uploads` Docker volume — include it in backups.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
