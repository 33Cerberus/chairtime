# ---- Core -------------------------------------------------------------
# production | development | test. Leaving it unset means production: development
# conveniences (codes shown on screen, test checkout, API docs) are then off.
NODE_ENV=development
PORT=4000
# Public origin of the web app (CORS, links in invites). Must be https:// in production.
WEB_ORIGIN=http://localhost:5173
# docker-compose maps Postgres to host port 5433
DATABASE_URL=postgresql://chairtime:chairtime@localhost:5433/chairtime?schema=public
# Number of reverse proxies in front of the API (usually 1 in production).
# TRUST_PROXY=1
# Folder with the built web app; when set, the API serves it.
# WEB_DIST=../web/dist

# ---- Auth -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-in-production-change-me-in-production
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ---- Payments (optional) ----------------------------------------------
# All three, or none. Without them: a test checkout in development, and in production
# online payment is switched off (clients pay at the shop).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Staging only: allow the test checkout with NODE_ENV=production.
# ALLOW_MOCK_PAYMENTS=true

# ---- Text messages (optional) -----------------------------------------
# All three, or none. Without them: messages are printed to the log in development, and
# in production they are not sent at all.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- File storage (optional) ------------------------------------------
# Leave S3_BUCKET empty to store uploads on local disk under ./uploads.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- Shop -------------------------------------------------------------
SHOP_TIMEZONE=Europe/Warsaw
# Serve Swagger at /api/docs in production too.
# ENABLE_API_DOCS=true
