# ---- Core -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the web app (CORS, links in invites)
WEB_ORIGIN=http://localhost:5173
# docker-compose maps Postgres to host port 5433
DATABASE_URL=postgresql://chairtime:chairtime@localhost:5433/chairtime?schema=public

# ---- Auth -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-in-production-change-me-in-production
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ---- Payments (optional) ----------------------------------------------
# Leave empty to use the built-in mock provider (local development only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- File storage (optional) ------------------------------------------
# Leave S3_BUCKET empty to store uploads on local disk under ./uploads.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- Shop -------------------------------------------------------------
SHOP_TIMEZONE=Europe/Warsaw
